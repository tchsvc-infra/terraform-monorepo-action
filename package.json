{
  "name": "terraform-monorepo-action",
  "version": "2.0.0",
  "description": "GitHub Action that detects changed Terraform/OpenTofu modules in a monorepo",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin typescript",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaware/terraform-monorepo-action.git"
  },
  "author": "vivicta",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
